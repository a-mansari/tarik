# Copy to .env. Encrypts stored credentials: losing it makes them unreadable.
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Tarik workflows: the Experio/Odoo they work on. Read through $env,
# which needs N8N_BLOCK_ENV_ACCESS_IN_NODE=false on the n8n service.
ODOO_URL=
ODOO_DB=
ODOO_UID=
ODOO_USER=
ODOO_API_KEY=
# 1 = read and report only, nothing posted to Odoo.
DRY_RUN=1
