# Copy to .env (never in git). A change applies at the next `docker compose up -d`.
# Each cabinet's own settings (Experio login, mailbox) are not here: an admin adds them on the Ajouter un cabinet page.

# ---- Required ----
# Experio's address, without a trailing slash.
ODOO_URL=
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
# docker-compose.prod.yml only: the reverse proxy's address, comma-separated. "*" only when nothing else can reach the
# port (TARIK_BIND). Login throttling keys on the address the proxy forwards.
TARIK_TRUSTED_PROXIES=

# ---- Mail server (needed before the first cabinet is added) ----
IMAP_HOST=
IMAP_PORT=993
IMAP_FOLDER=INBOX
SMTP_HOST=
# 465 = SSL, 587 = STARTTLS
SMTP_PORT=465
# SHA-256 fingerprint of a self-signed mail certificate; empty: the usual check.
MAIL_CERT_SHA256=

# ---- Models (at least one) ----
# Claude, the default LLM: `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
# MiniMax: its Anthropic-style API address and key.
MODEL_API_URL=
MODEL_API_KEY=

# ---- Experio, Gladden, WhatsApp (empty: not used) ----
# What the Experio app sends to /api/. Generate with: openssl rand -hex 32
EXPERIO_API_KEY=
# This server as clients reach it (form links, WhatsApp's callback). Keep /formulaire/ out of long-lived proxy logs.
PUBLIC_URL=
# Gladden's /gladden and this server's /gladden as Gladden reaches it: both set to use it.
GLADDEN_URL=
GLADDEN_CALLBACK_URL=
# Sparrow: the relay's address, Experio's one sender id and its master token.
SPARROW_URL=
SPARROW_SENDER_ID=
SPARROW_TOKEN=

# ---- Server ----
# The bundled Vault container's address: leave as is.
VAULT_ADDR=http://vault:8200
# Script token (run.py, content import). Empty: no script accepted. Generate with: openssl rand -hex 32
TARIK_GRAPH_TOKEN=
# The cabinet a run takes when it names none (a cabinet's exact Experio database name); empty is fine.
TARIK_DEFAULT_CABINET=
# What the compose files publish the server on (the container listens on 2024). 127.0.0.1: this machine only.
TARIK_BIND=127.0.0.1
TARIK_PORT=2024
# docker-compose.prod.yml only: the image to run (built, or pulled from your registry).
TARIK_IMAGE=tarik:latest

# ---- Memory (Hindsight, off by default: set the URL and token, then `docker compose --profile memory up -d`) ----
HINDSIGHT_URL=
# A Claude Code subscription token (`claude setup-token`), for its fact extraction.
HINDSIGHT_LLM_TOKEN=

# ---- Image build ----
# INSTALL_CLAUDE_CODE=0 leaves the Claude Code CLI out (only a Claude cabinet uses it).
INSTALL_CLAUDE_CODE=1
