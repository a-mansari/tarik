# Copy to .env (never in git). Everything the stack needs to START lives here: its addresses, its own database's
# password and its limits. Tarik's other secrets and each cabinet's settings live in Vault (the end of this file).
# No address and no secret is written in the code: what is not in this file or in Vault is a default listed below.

# ---- Required ----------------------------------------------------------------------------------------------------
# The Experio server every cabinet is on (its address, without a trailing slash).
ODOO_URL=
# The stack's own Postgres. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
# The model provider's Anthropic-style address (MiniMax-M3's: https://api.minimax.io/anthropic). The stack's default;
# Vault's MODEL_API_URL (secret/tarik/orchestrator) overrides it (the server refuses to start with MODEL_API_URL in the
# environment: a Vault setting has no second copy). The model's key is in Vault (MODEL_API_KEY).
TARIK_MODEL_URL=
# Vault's address as the server reaches it (the bundled Vault container's: http://vault:8200).
VAULT_ADDR=
# The cabinet a run belongs to when it names none: a cabinet's exact Experio database name (a Vault cabinet path).
TARIK_DEFAULT_CABINET=
# The DNS resolvers docker-compose.yml gives the server (docker-compose.prod.yml leaves the host's own).
DNS_PRIMARY=
DNS_SECONDARY=

# ---- Image build (docker compose build) --------------------------------------------------------------------------
# The Claude Code CLI, used only by a cabinet whose model is Claude (MODEL_ADAPTER claude-code, the Cabinets page).
# INSTALL_CLAUDE_CODE=0 leaves it out of the image: the two next lines are then not read.
INSTALL_CLAUDE_CODE=1
CLAUDE_INSTALL_URL=
CLAUDE_CODE_VERSION=

# ---- Optional (the default after "=" when the line is absent) ----------------------------------------------------
# Bearer token for scripts (run.py, the import of content, a health or admin script). Empty: no script is accepted,
# only people logged in on the pages. Generate with: openssl rand -hex 32
TARIK_GRAPH_TOKEN=
# The server's own address for run.py (the client): http://127.0.0.1:2024
TARIK_GRAPH_URL=
# The address and port the server listens on in its container (0.0.0.0, 2024), and the host address and port the
# compose files publish it on (127.0.0.1: this machine only; 0.0.0.0 or an interface's address: reachable).
TARIK_HOST=0.0.0.0
TARIK_PORT=2024
TARIK_BIND=127.0.0.1
# Which proxies' X-Forwarded-For / -Proto the server believes (the login throttle keys on the address it gives).
# "*": any sender, fit only when nothing but your proxy reaches the port. Else the proxy's address, comma-separated.
TARIK_TRUSTED_PROXIES=*
# The stack's Postgres: its host (db: the compose service; set it for a managed Postgres), database and user.
POSTGRES_HOST=db
POSTGRES_DB=tarik
POSTGRES_USER=tarik
# How many days the model calls' prompts are kept, then dropped: 30
TARIK_PROMPTS_KEEP_DAYS=30
# Model calls at once: per cabinet 10, in total 40; Claude Code CLI processes at once 10.
TARIK_CALLS_PER_CABINET=10
TARIK_CALLS_TOTAL=40
TARIK_MODEL_CALLS=10
# docker-compose.prod.yml only: the image to run (built by `docker compose -f docker-compose.prod.yml build`, or pulled
# from your registry).
TARIK_IMAGE=tarik-server:latest
# docker-compose.prod.yml only, REQUIRED: the folder of Vault seed files (deploy/seed.example/ is the template; the real
# one holds secrets, keep it out of git), loaded into Vault by the vault-init container into each path that does not
# exist yet. 1: merge the files' keys into existing paths too (after changing a key in a file).
TARIK_SEED_DIR=
VAULT_SEED_OVERWRITE=0

# ---- In Vault, not here ------------------------------------------------------------------------------------------
#
# secret/tarik/orchestrator, this stack's own:
#   MODEL_API_KEY      the model's key (MiniMax-M3, at MODEL_API_URL)
#   MODEL_API_URL      optional, overrides .env's TARIK_MODEL_URL
#   EXPERIO_API_KEY    the key the Experio app shows to this server's /api/ (made once by vault/setup.sh, random)
#
# secret/tarik/shared, the same for every cabinet:
#   IMAP_HOST, IMAP_PORT (993), IMAP_FOLDER (INBOX), SMTP_HOST, SMTP_PORT (465 = SSL, 587 = STARTTLS)
#   MAIL_CERT_SHA256   the mail server's certificate fingerprint when it is self-signed (empty: usual check)
#   GLADDEN_URL, GLADDEN_CALLBACK_URL  optional, Experio's classifier (https://runner.experioservices.com/gladden on
#                      the test runner) and this server's /gladden as it reaches it (public): both set, files are
#                      identified by Gladden first, by the model when it doesn't answer
#
# secret/tarik/cabinets/<cabinet's exact Experio database>, one per cabinet (the cabinets are these paths):
#   ODOO_UID, ODOO_USER, ODOO_PASSWORD (or ODOO_API_KEY)  Tarik's user in that cabinet: a login
#                      returning another uid (wrong cabinet) fails every call
#   DRY_RUN            1 (default): read and report only, nothing posted to Experio
#   IMAP_USER, IMAP_PASSWORD, SMTP_USER, SMTP_PASSWORD, SMTP_FROM  the cabinet's own mailbox
#   MAIL_MANAGER       told when a sender Tarik refuses writes to them (fallback to Experio's Responsable)
#   MAIL_ALLOWED_RECIPIENTS  who may receive Tarik's emails: addresses, @domain, patterns with *; empty = nobody
#   MODEL_ADAPTER      minimax (default) or claude-code (then CLAUDE_CODE_OAUTH_TOKEN)
#
# Each cabinet's own settings can also be changed on the Cabinets page (its own AppRole, vault/setup.sh).
