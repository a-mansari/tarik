# Copy to .env. Encrypts stored credentials: losing it makes them unreadable.
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Tarik's MCP tools (mcp/): the Experio/Odoo they work on.
ODOO_URL=
ODOO_DB=
# Tarik's user id in this cabinet: a login returning another id (wrong cabinet) fails every call.
ODOO_UID=
ODOO_USER=
ODOO_PASSWORD=
ODOO_API_KEY=
# 1 = read and report only, nothing posted to Odoo.
DRY_RUN=1

# Tarik's chat memory. Generate the password with: openssl rand -hex 24
POSTGRES_DB=tarik
POSTGRES_USER=tarik
POSTGRES_PASSWORD=

# Vision model for split_invoices (several invoices in one PDF): MiniMax-M3, the same
# MiniMax account as Tarik's chat model in n8n. MiniMax speaks the Anthropic message
# format, so MODEL_API_URL is MiniMax's .../anthropic endpoint. No Claude is involved.
MODEL_API_KEY=
MODEL_API_URL=
MODEL_API_NAME=
