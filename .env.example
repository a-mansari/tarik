# Copy to .env. Only what the services need to start lives here; Tarik's secrets and per-cabinet
# settings live in Vault (vault/, README "Vault"), which tarik-mcp reads at start and every 5 minutes.
# tarik-mcp and tarik-mail-watch get only the variables docker-compose.yml names, never the whole file.

# Encrypts n8n's stored credentials: losing it makes them unreadable.
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Postgres: Tarik's data (one schema per cabinet) in POSTGRES_DB, n8n's own in N8N_POSTGRES_DB.
# Generate the password with: openssl rand -hex 24
POSTGRES_DB=tarik
POSTGRES_USER=tarik
POSTGRES_PASSWORD=
N8N_POSTGRES_DB=n8n

# The Experio server every cabinet is on.
ODOO_URL=
# Tool calls running at once: per cabinet, and in all (calls beyond wait their turn).
TARIK_CALLS_PER_CABINET=10
TARIK_CALLS_TOTAL=40
# n8n's MCP server, as this machine reaches it (workflows/build_tarik_agents.py). tarik-mcp reaches
# it at http://n8n:5678/mcp-server/http (docker-compose.yml). Its token is in Vault.
N8N_MCP_API_URL=http://localhost:5678/mcp-server/http

# ---- In Vault, not here ------------------------------------------------------------------------
#
# secret/tarik/shared, the same for every cabinet:
#   IMAP_HOST, IMAP_PORT (993), IMAP_FOLDER (INBOX), SMTP_HOST, SMTP_PORT (465 = SSL, 587 = STARTTLS)
#   MAIL_CERT_SHA256   the mail server's certificate fingerprint when it is self-signed (empty: usual check)
#   N8N_MCP_API_TOKEN  n8n's MCP token (Settings > n8n MCP): emails are answered through it
#   MAIL_WEBHOOK_SECRET  tarik-mail-watch's header to "Tarik - Emails" (also in the n8n credential "Tarik mail webhook")
#   MODEL_API_KEY, MODEL_API_URL, MODEL_API_NAME  the vision model that reads the scans and answers (MiniMax-M3, the
#                      same account as the agents in n8n, at MiniMax's .../anthropic endpoint)
#
# secret/tarik/cabinets/<cabinet's exact Experio database>, one per cabinet (the cabinets are these paths):
#   ODOO_UID, ODOO_USER, ODOO_PASSWORD (or ODOO_API_KEY)  Tarik's user in that cabinet: a login
#                      returning another uid (wrong cabinet) fails every call
#   DRY_RUN            1 (default): read and report only, nothing posted to Experio
#   IMAP_USER, IMAP_PASSWORD, SMTP_USER, SMTP_PASSWORD, SMTP_FROM  the cabinet's own mailbox
#   MAIL_MANAGER       told when a sender Tarik refuses writes to him (fallback to Experio's Responsable)
#   MAIL_ALLOWED_RECIPIENTS  who may receive Tarik's emails: addresses, @domain, patterns with *; empty = nobody
#   AGENT_ID           the cabinet's agent in n8n (workflows/build_tarik_agents.py prints it)
