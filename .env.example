# Copy to .env (never in git). Everything the stack needs to START lives here: its addresses, its own database's
# password, its limits, and the settings every cabinet shares (mail server, model, Gladden, Sparrow). Each cabinet's own
# settings (its Experio login, its mailbox) are made on the Cabinets page and kept in Vault (the end of this file).
# No address and no secret is written in the code: what is not in this file or in Vault is a default listed below.
# A change here applies at the next start of the server (docker compose up -d).

# ---- Required ----------------------------------------------------------------------------------------------------
# The Experio server every cabinet is on (its address, without a trailing slash).
ODOO_URL=
# The stack's own Postgres. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
# docker-compose.prod.yml only, REQUIRED: which proxies' X-Forwarded-For / -Proto the server believes (the login
# throttle keys on the address they give): the reverse proxy's address, comma-separated. "*" trusts any sender: only
# when nothing but your proxy can reach the port (TARIK_BIND below), else a client could pick its own address and dodge
# the throttle. (docker-compose.yml, for development, defaults to "*".)
TARIK_TRUSTED_PROXIES=

# ---- Shared by every cabinet (the Paramètres page shows them, read only) ---------------------------------------------
# The mail server: Tarik reads and sends each cabinet's mailbox there (the mailbox's login is the cabinet's own).
# Needed before the first cabinet is added, not to start the stack.
IMAP_HOST=
IMAP_PORT=993
IMAP_FOLDER=INBOX
SMTP_HOST=
# 465 = SSL, 587 = STARTTLS
SMTP_PORT=465
# The mail server's certificate fingerprint (SHA-256) when it is self-signed; empty: the usual check.
MAIL_CERT_SHA256=
# The Experio app's key for this server's /api/ (create, change or close cabinets). Generate with: openssl rand -hex 32
# Empty: the /api/ accepts no key.
EXPERIO_API_KEY=
# The models. Claude (the default LLM): the CLI's login, from `claude setup-token`. MiniMax: its Anthropic-style API
# address and key (MiniMax is unusable without the address). A cabinet picks its LLM on its Réglages page.
CLAUDE_CODE_OAUTH_TOKEN=
MODEL_API_URL=
MODEL_API_KEY=
# This server as clients reach it (a new dossier's form link, and the host Sparrow calls Tarik on); empty: Tarik asks
# the settings by email. The form link holds a one-time key in its path: keep /formulaire/ out of long-lived proxy logs.
PUBLIC_URL=
# Experio's classifier, Gladden (its runner's /gladden), and this server's /gladden as Gladden reaches it (public).
# Both set: files are identified by Gladden first, by the model when it does not answer. Empty: not used.
GLADDEN_URL=
GLADDEN_CALLBACK_URL=
# Experio's WhatsApp relay (Sparrow), its one WhatsApp sender id and its master token. Empty: no WhatsApp.
SPARROW_URL=
SPARROW_SENDER_ID=
SPARROW_TOKEN=
# 0 turns Tarik's memory off for every cabinet (empty: on, when the memory below is set up).
MEMORY_ENABLED=

# ---- Image build (docker compose build) --------------------------------------------------------------------------
# The Claude Code CLI, used by an LLM of the type claude-code (Claude, the default; the Réglages and Paramètres pages).
# INSTALL_CLAUDE_CODE=0 leaves it out of the image: the two next lines are then not read.
INSTALL_CLAUDE_CODE=1
# CLAUDE_INSTALL_URL=https://claude.ai/install.sh  (docker-compose.prod.yml's default; set to use another)
# CLAUDE_CODE_VERSION=2.1.300                      (the version the image installs)

# ---- Optional (the default after "=" when the line is absent) ----------------------------------------------------
# Vault's address as the server reaches it: the bundled Vault container's, http://vault:8200, unless set.
# VAULT_ADDR=http://vault:8200
# Bearer token for scripts (run.py, the import of content, a health or admin script). Empty: no script is accepted,
# only people logged in on the pages. Generate with: openssl rand -hex 32
TARIK_GRAPH_TOKEN=
# The cabinet a run belongs to when it names none (run.py, scripts): a cabinet's exact Experio database name. Empty is fine.
TARIK_DEFAULT_CABINET=
# The server's own address for run.py (the client): http://127.0.0.1:2024
TARIK_GRAPH_URL=
# The host address and port the compose files publish the server on (the container itself always listens on 2024):
# 127.0.0.1: this machine only; an interface's address: reachable from the network, then set TARIK_TRUSTED_PROXIES.
TARIK_BIND=127.0.0.1
TARIK_PORT=2024
# docker-compose.yml only (development): the resolvers the server container uses (1.1.1.1 and 8.8.8.8).
DNS_PRIMARY=1.1.1.1
DNS_SECONDARY=8.8.8.8
# The stack's Postgres: its host (db: the compose service; set it for a managed Postgres), database and user.
POSTGRES_HOST=db
POSTGRES_DB=tarik
POSTGRES_USER=tarik
# How many days the model calls' prompts are kept, then dropped: 30
TARIK_PROMPTS_KEEP_DAYS=30
# Model calls at once: per cabinet 10, in total 40; Claude Code CLI processes at once 10.
TARIK_CALLS_PER_CABINET=10
TARIK_CALLS_TOTAL=40
TARIK_MODEL_CALLS=10
# Tarik's memory (Hindsight, engine/memory.py), off by default. To turn it on: HINDSIGHT_URL=http://hindsight:8888,
# HINDSIGHT_LLM_TOKEN (a Claude Code subscription token: `claude setup-token`; it extracts the facts to keep), then
# `docker compose --profile memory up -d` (add `-f docker-compose.prod.yml` in a deployment).
HINDSIGHT_URL=
HINDSIGHT_LLM_TOKEN=
HINDSIGHT_LLM_MODEL=sonnet
# docker-compose.prod.yml only: the image to run (built by `docker compose -f docker-compose.prod.yml build`, or pulled
# from your registry).
TARIK_IMAGE=tarik:latest

# ---- In Vault, not here ------------------------------------------------------------------------------------------
#
# secret/tarik/cabinets/<cabinet's exact Experio database>, one per cabinet (the cabinets are these paths):
#   ODOO_USER, ODOO_PASSWORD (or ODOO_API_KEY)  Tarik's user in that cabinet; ODOO_UID (optional) pins its
#                      user id: a login returning another uid fails every call (empty: the login's own uid)
#   DRY_RUN            1 (default): read and report only, nothing posted to Experio
#   IMAP_USER, IMAP_PASSWORD, SMTP_USER, SMTP_PASSWORD, SMTP_FROM  the cabinet's own mailbox
#   MAIL_MANAGER       told when a sender Tarik refuses writes to them (fallback to Experio's Responsable)
#   MAIL_ALLOWED_RECIPIENTS  who may receive Tarik's emails: addresses, @domain, patterns with *; empty = nobody
#   MAIL_IGNORED_SENDERS     senders whose emails are set aside quietly, no manager alert: same format; empty = none
#
# Each cabinet's own settings can also be changed on the Cabinets page (its own AppRole, vault/setup.sh).
