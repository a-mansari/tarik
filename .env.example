# Copy to .env. Settings are either shared by every cabinet, or one cabinet's own, prefixed with
# its name in capitals (EXPERIO_CABINET_8__ODOO_UID). Never both: tarik-mcp refuses to start when
# a setting is in the wrong place (mcp/tarik/core/cabinets.py). None is ever shown to the agent.

# ---- Shared ----------------------------------------------------------------------------------

# Encrypts n8n's stored credentials: losing it makes them unreadable.
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Postgres: Tarik's data (one schema per cabinet) in POSTGRES_DB, n8n's own in N8N_POSTGRES_DB.
# Generate the password with: openssl rand -hex 24
POSTGRES_DB=tarik
POSTGRES_USER=tarik
POSTGRES_PASSWORD=
N8N_POSTGRES_DB=n8n

# The Experio server every cabinet is on.
ODOO_URL=
# The cabinets Tarik serves: their exact Experio database names, comma-separated.
TARIK_CABINETS=experio_cabinet_8
# Tool calls running at once: per cabinet, and in all (calls beyond wait their turn).
TARIK_CALLS_PER_CABINET=10
TARIK_CALLS_TOTAL=40

# Vision model for split_invoices (several invoices in one PDF): MiniMax-M3, the same
# MiniMax account as Tarik's chat model in n8n. MiniMax speaks the Anthropic message
# format, so MODEL_API_URL is MiniMax's .../anthropic endpoint. No Claude is involved.
MODEL_API_KEY=
MODEL_API_URL=
MODEL_API_NAME=

# The mail server: emails are read over IMAP (read-only) and replies sent over SMTP.
IMAP_HOST=
IMAP_PORT=993
IMAP_FOLDER=INBOX
# 465 = SSL, 587 = STARTTLS. Certificates are always verified (see MAIL_CERT_SHA256).
SMTP_HOST=
SMTP_PORT=465
# The mail server's certificate SHA-256 fingerprint, when it is self-signed (mailcow's own):
# only that certificate is accepted. Update it when the certificate changes. Empty = usual check.
MAIL_CERT_SHA256=

# ---- One block per cabinet (here experio_cabinet_8) --------------------------------------------

# Tarik's user id in this cabinet: a login returning another id (wrong cabinet) fails every call.
EXPERIO_CABINET_8__ODOO_UID=
EXPERIO_CABINET_8__ODOO_USER=
EXPERIO_CABINET_8__ODOO_PASSWORD=
# Empty: ODOO_PASSWORD is used.
EXPERIO_CABINET_8__ODOO_API_KEY=
# 1 = read and report only, nothing posted to Experio.
EXPERIO_CABINET_8__DRY_RUN=1
# The cabinet's own mailbox on the mail server.
EXPERIO_CABINET_8__IMAP_USER=
EXPERIO_CABINET_8__IMAP_PASSWORD=
EXPERIO_CABINET_8__SMTP_USER=
EXPERIO_CABINET_8__SMTP_PASSWORD=
EXPERIO_CABINET_8__SMTP_FROM=
# Told when a sender Tarik refuses writes to him: the Responsable of the cabinet's own company in
# Experio, else this collaborator's email (fallback).
EXPERIO_CABINET_8__MAIL_MANAGER=
# Who may receive an email from Tarik, comma-separated: addresses, @domain for a whole domain,
# or patterns with * (test.*@experio.ma; * alone = anyone). Empty = nobody: no email leaves.
EXPERIO_CABINET_8__MAIL_ALLOWED_RECIPIENTS=
