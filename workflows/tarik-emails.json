      "parameters": {
        "jsCode": "// One item per thread waiting for an answer (claim_threads locked them for this run).\n// None when tarik-mcp answered without them (restarting): the next wake-up takes them.\nreturn ($input.first().json.content?.[0]?.text?.threads ?? []).map(thread => ({ json: thread }));"
      }
