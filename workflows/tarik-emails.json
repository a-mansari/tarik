{
  "id": "TarikEmails00001",
  "name": "Tarik - Emails",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true
  },
  "nodes": [
    {
      "id": "6335ccf4-0458-551b-8ccd-ef3c35edfed5",
      "name": "Toutes les 2 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      }
    },
    {
      "id": "808d2c0c-10f3-51b0-b594-29f7eb96a691",
      "name": "Nouvel email",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        120
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "tarik-nouvel-email",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "5d0f6c2a-8e4b-4f17-9a3c-2b7e1d6f8a40"
    },
    {
      "id": "d5265d5a-940d-5ae8-8ce7-f91b92bec63d",
      "name": "Nouveaux emails (fetch_emails)",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1.1,
      "position": [
        220,
        300
      ],
      "parameters": {
        "endpointUrl": "http://tarik-mcp:8000/c/experio_cabinet_8/mcp",
        "serverTransport": "httpStreamable",
        "tool": {
          "__rl": true,
          "mode": "id",
          "value": "fetch_emails"
        },
        "inputMode": "json",
        "jsonInput": "={{ JSON.stringify({}) }}",
        "options": {
          "timeout": 300000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "fe9b1390-56b4-5275-a24c-94fd1dd57e1f",
      "name": "Un element par fil",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "// One item per thread waiting for an answer (fetch_emails locked them for this run).\nreturn $input.first().json.content[0].text.threads.map(thread => ({ json: thread }));"
      }
    },
    {
      "id": "28285773-1f60-5e25-87ad-6eefd09d3a22",
      "name": "Tarik",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1.1,
      "position": [
        660,
        300
      ],
      "parameters": {
        "endpointUrl": "http://tarik-mcp:8000/c/experio_cabinet_8/mcp",
        "serverTransport": "httpStreamable",
        "tool": {
          "__rl": true,
          "mode": "id",
          "value": "ask_agent"
        },
        "inputMode": "json",
        "jsonInput": "={{ JSON.stringify({ session_id: $json.session_id, message: $json.message, files: $json.files }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "574c325a-dabd-5051-8386-a0f1b5577dff",
      "name": "Reponse (send_email)",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1.1,
      "position": [
        880,
        300
      ],
      "parameters": {
        "endpointUrl": "http://tarik-mcp:8000/c/experio_cabinet_8/mcp",
        "serverTransport": "httpStreamable",
        "tool": {
          "__rl": true,
          "mode": "id",
          "value": "send_email"
        },
        "inputMode": "json",
        "jsonInput": "={{ JSON.stringify({ to: $('Un element par fil').item.json.to, subject: $('Un element par fil').item.json.subject, body: $('Tarik').item.json.content[0].text.output, in_reply_to: $('Un element par fil').item.json.in_reply_to, references: $('Un element par fil').item.json.references }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "e484cade-acf6-5298-bb41-f7364af5d84e",
      "name": "Fil traite (finish_thread)",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1.1,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "endpointUrl": "http://tarik-mcp:8000/c/experio_cabinet_8/mcp",
        "serverTransport": "httpStreamable",
        "tool": {
          "__rl": true,
          "mode": "id",
          "value": "finish_thread"
        },
        "inputMode": "json",
        "jsonInput": "={{ JSON.stringify({ thread_id: $('Un element par fil').item.json.thread_id, message_ids: $('Un element par fil').item.json.message_ids, sent: !$json.error, reason: $json.error ? String($json.error.message ?? $json.error).replace(/^Error executing tool \\w+: /, '') : '' }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "d8451cd4-0197-5917-8fe1-34125097fd8d",
      "name": "Refus de droits ? (thread_refusal)",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1.1,
      "position": [
        770,
        300
      ],
      "parameters": {
        "endpointUrl": "http://tarik-mcp:8000/c/experio_cabinet_8/mcp",
        "serverTransport": "httpStreamable",
        "tool": {
          "__rl": true,
          "mode": "id",
          "value": "thread_refusal"
        },
        "inputMode": "json",
        "jsonInput": "={{ JSON.stringify({ thread_id: $('Un element par fil').item.json.thread_id }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "aad568d9-8492-5f97-b177-4736c5a5c7ec",
      "name": "Refuse ?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        820,
        360
      ],
      "parameters": {
        "mode": "expression",
        "numberOutputs": 2,
        "output": "={{ $json.content[0].text.refused ? 1 : 0 }}"
      }
    },
    {
      "id": "39dc80d4-d7cc-51be-ba0e-0ff880d8e0f9",
      "name": "Manager prevenu (notify_manager)",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1.1,
      "position": [
        880,
        480
      ],
      "parameters": {
        "endpointUrl": "http://tarik-mcp:8000/c/experio_cabinet_8/mcp",
        "serverTransport": "httpStreamable",
        "tool": {
          "__rl": true,
          "mode": "id",
          "value": "notify_manager"
        },
        "inputMode": "json",
        "jsonInput": "={{ JSON.stringify({ sender: $json.content[0].text.sender, subject: $json.content[0].text.subject, reason: $json.content[0].text.reason }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "cd0994b5-4614-538b-ae38-7b699f91cc21",
      "name": "Une alerte par refus",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        520
      ],
      "parameters": {
        "jsCode": "// One item per email whose sender fetch_emails refused.\nreturn $input.first().json.content[0].text.alerts.map(alert => ({ json: alert }));"
      }
    },
    {
      "id": "ad698c05-bad7-5a8f-b795-17bc79b156a0",
      "name": "Manager prevenu de l'expediteur (notify_manager)",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1.1,
      "position": [
        660,
        520
      ],
      "parameters": {
        "endpointUrl": "http://tarik-mcp:8000/c/experio_cabinet_8/mcp",
        "serverTransport": "httpStreamable",
        "tool": {
          "__rl": true,
          "mode": "id",
          "value": "notify_manager"
        },
        "inputMode": "json",
        "jsonInput": "={{ JSON.stringify({ sender: $json.sender, subject: $json.subject, reason: $json.reason }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "onError": "continueErrorOutput"
    }
  ],
