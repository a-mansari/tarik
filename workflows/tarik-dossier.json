{
  "id": "TarikDossier0001",
  "name": "Tarik - Dossier",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "saveExecutionProgress": true
  },
