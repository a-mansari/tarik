    {
      "id": "eb584d04-b828-50c8-a5b3-52b085292317",
      "name": "Nouveau dossier ?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "expression",
        "numberOutputs": 2,
        "output": "={{ $('Appel').first().json.dossier_id > 0 ? 1 : 0 }}"
      }
    },
    {
      "id": "de09fced-765b-5ce2-91ff-9651f3202972",
      "name": "Creation (create_dossier)",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1.1,
      "position": [
        440,
        200
      ],
      "parameters": {
        "endpointUrl": "http://tarik-mcp:8000/mcp",
        "serverTransport": "httpStreamable",
        "tool": {
          "__rl": true,
          "mode": "id",
          "value": "create_dossier"
        },
        "inputMode": "json",
        "jsonInput": "={{ JSON.stringify({ name: $('Appel').first().json.name, ice: $('Appel').first().json.ice || '', if_number: $('Appel').first().json.if_number || '', folder_type: $('Appel').first().json.folder_type || 'company', skip_ice_if_check: $('Appel').first().json.skip_ice_if_check === true, client_message: $('Appel').first().json.client_message || '', session_id: $('Appel').first().json.session_id }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "a0a9516f-b443-54cb-b350-f514101d8bc0",
      "name": "Suite apres create_dossier",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        660,
        200
      ],
      "parameters": {
        "mode": "expression",
        "numberOutputs": 2,
        "output": "={{ $json.content[0].text.status === 'ok' ? 0 : 1 }}"
      }
    },
    {
      "id": "53e037ea-0ddb-5666-9227-bb20596ad5c1",
      "name": "Modele ?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        880,
        200
      ],
      "parameters": {
        "mode": "expression",
        "numberOutputs": 2,
        "output": "={{ $('Appel').first().json.model_dossier_id > 0 && !$json.content[0].text.reused ? 0 : 1 }}"
      }
    },
    {
      "id": "a7d48546-d418-56e2-9ae1-9d0b4383d00e",
      "name": "Configuration (copy_configuration)",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1.1,
      "position": [
        1100,
        120
      ],
      "parameters": {
        "endpointUrl": "http://tarik-mcp:8000/mcp",
        "serverTransport": "httpStreamable",
        "tool": {
          "__rl": true,
          "mode": "id",
          "value": "copy_configuration"
        },
        "inputMode": "json",
        "jsonInput": "={{ JSON.stringify({ dossier_id: $('Creation (create_dossier)').first().json.content[0].text.dossier_id, model_dossier_id: $('Appel').first().json.model_dossier_id, session_id: $('Appel').first().json.session_id, client_message: $('Appel').first().json.client_message || '' }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "552e83f6-325b-5551-a47b-5750daf2af34",
      "name": "Suite apres copy_configuration",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        1320,
        120
      ],
      "parameters": {
        "mode": "expression",
        "numberOutputs": 2,
        "output": "={{ $json.content[0].text.status === 'ok' ? 0 : 1 }}"
      }
    },
    {
      "id": "3ecb627e-5800-5fd2-b1c0-c5cfcec74d34",
      "name": "Dossier cible",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ],
      "parameters": {
        "jsCode": "// The dossier the rest works on: the one given, or the one just created.\nconst call = $('Appel').first().json;\nreturn [{ json: { dossier_id: call.dossier_id > 0 ? call.dossier_id : $('Creation (create_dossier)').first().json.content[0].text.dossier_id } }];"
      }
    },
    {
      "id": "cfced91b-caad-5f5a-8a46-9eb4621f4184",
      "name": "Fichiers du message (files_to_process)",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1.1,
      "position": [
        1760,
        200
      ],
      "parameters": {
        "endpointUrl": "http://tarik-mcp:8000/mcp",
        "serverTransport": "httpStreamable",
        "tool": {
          "__rl": true,
          "mode": "id",
          "value": "files_to_process"
        },
        "inputMode": "json",
        "jsonInput": "={{ JSON.stringify({ session_id: $('Appel').first().json.session_id, entries: true }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "12f3721d-4efe-5482-b562-aad1871397e7",
      "name": "Un element par fichier",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        200
      ],
      "parameters": {
        "jsCode": "// One item per file to import (files_to_process picked the conversation's FEC and grand livre files not imported yet).\nreturn $input.first().json.content[0].text.files.map(file_id => ({ json: { file_id } }));"
      }
    },
    {
      "id": "50237e88-35a4-573b-9640-4273bb492797",
      "name": "Ecritures (import_entries)",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1.1,
      "position": [
        2200,
        200
      ],
      "parameters": {
        "endpointUrl": "http://tarik-mcp:8000/mcp",
        "serverTransport": "httpStreamable",
        "tool": {
          "__rl": true,
          "mode": "id",
          "value": "import_entries"
        },
        "inputMode": "json",
        "jsonInput": "={{ JSON.stringify({ dossier_id: $('Dossier cible').first().json.dossier_id, file_id: $json.file_id, kind: $('Appel').first().json.kind || '' }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "5fe52d81-4d0d-5c40-a633-2530f60b2bbf",
      "name": "Imports acceptes ?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        460
      ],
      "parameters": {
        "jsCode": "// Finishing hands the entries to Experio: not with a refused file, which the client sends again.\nconst imports = $('Ecritures (import_entries)').isExecuted ? [...$('Ecritures (import_entries)').all(0), ...$('Ecritures (import_entries)').all(1)] : [];  // answers and errors\nconst refused = imports.some(item => item.json.error || item.json.content?.[0]?.text?.status !== 'ok');\nreturn refused ? [] : [{ json: {} }];"
      }
    },
    {
      "id": "83fb6823-1a77-50c1-bb76-a07544f91edd",
