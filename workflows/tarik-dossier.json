        "inputMode": "json",
        "jsonInput": "={{ JSON.stringify({ run_id: String($execution.id), session_id: $('Appel').first().json.session_id, origin: $prevNode.name, result: $json.error ? { status: 'error', message: String($json.error.message ?? $json.error) } : $json.content[0].text }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
