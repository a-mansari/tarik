          "value": "files_to_process"
        },
        "inputMode": "json",
        "jsonInput": "={{ JSON.stringify({ session_id: $('Appel').first().json.session_id }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "4f1bc170-8944-5db6-927f-5c53933e19e4",
