      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        200
      ],
      "parameters": {
        "jsCode": "// The files the agent passed, one item each. The model sends them as a list, a number or text (\"[40]\", \"40, 41\").\nconst raw = $('Appel').first().json.file_ids;\nconst ids = (Array.isArray(raw) ? raw : String(raw ?? '').match(/\\d+/g) || []).map(Number).filter(Boolean);\nreturn [...new Set(ids)].map(file_id => ({ json: { file_id } }));"
      }
    },
