      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "expression",
        "numberOutputs": 3,
        "output": "={{ $json.mode === 'answer' ? 1 : ($json.mode === 'resume' ? 2 : 0) }}"
      }
