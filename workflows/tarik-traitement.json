      "typeVersion": 2,
      "position": [
        440,
        200
      ],
      "parameters": {
        "jsCode": "// One item per file to process (files_to_process picked the conversation's invoices and statements not processed yet).\nreturn $input.first().json.content[0].text.files.map(file_id => ({ json: { file_id } }));"
