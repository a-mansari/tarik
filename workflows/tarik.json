      ],
      "parameters": {
        "public": true,
        "mode": "hostedChat",
        "initialMessages": "Bonjour, je suis Tarik. Envoyez-moi vos factures (PDF ou photos), ou le FEC d'un dossier.",
        "options": {
          "allowFileUploads": true,
          "allowedFilesMimeTypes": "application/pdf,image/*,text/csv,text/plain,.csv,.txt,.xlsx",
