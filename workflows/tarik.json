        }
      },
      "webhookId": "7304d10e-ea71-4883-be8d-dcd560c62f4e"
    },
    {
      "id": "c1a0b5e2-0001-4000-8000-000000000006",
      "name": "Fichiers recus",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// The uploaded files as one base64 payload, saved by save_files in this cabinet's tarik_files.\nconst message = $input.first().json;\nconst files = [];\nfor (const file of message.files || []) {\n  const buffer = await this.helpers.getBinaryDataBuffer(0, file.binaryKey);\n  files.push({ file_name: file.fileName, mime_type: file.mimeType, data: buffer.toString('base64') });\n}\nconst payload = Buffer.from(JSON.stringify({ session_id: message.sessionId, files })).toString('base64');\nreturn [{ json: { payload } }];"
      }
    },
    {
      "id": "c1a0b5e2-0001-4000-8000-000000000007",
      "name": "Enregistrer fichiers",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1.1,
      "position": [
        440,
        0
      ],
      "parameters": {
        "endpointUrl": "http://tarik-mcp:8000/c/experio_cabinet_8/mcp",
        "serverTransport": "httpStreamable",
        "tool": {
          "__rl": true,
          "mode": "id",
          "value": "save_files"
        },
        "inputMode": "json",
        "jsonInput": "={{ JSON.stringify({ payload: $json.payload }) }}",
        "options": {
          "timeout": 300000
        }
      }
    },
    {
      "id": "c1a0b5e2-0001-4000-8000-000000000002",
      "name": "Tarik",
