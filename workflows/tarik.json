    {
      "id": "c1a0b5e2-0001-4000-8000-000000000001",
      "name": "Message a Tarik",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ],
      "parameters": {
        "public": true,
        "mode": "hostedChat",
        "initialMessages": "Bonjour, je suis Tarik. Envoyez-moi vos factures (PDF ou photos).",
        "options": {
          "allowFileUploads": true,
          "allowedFilesMimeTypes": "application/pdf,image/*",
          "title": "Tarik",
          "subtitle": "Assistant comptable",
          "inputPlaceholder": "Votre message..."
        }
      },
      "webhookId": "7304d10e-ea71-4883-be8d-dcd560c62f4e"
    },
    {
      "id": "c1a0b5e2-0001-4000-8000-000000000006",
      "name": "Fichiers recus",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// The uploaded files as one base64 payload: a single query parameter, free of the commas the Postgres node splits on.\nconst message = $input.first().json;\nconst files = [];\nfor (const file of message.files || []) {\n  const buffer = await this.helpers.getBinaryDataBuffer(0, file.binaryKey);\n  files.push({ file_name: file.fileName, mime_type: file.mimeType, data: buffer.toString('base64') });\n}\nconst payload = Buffer.from(JSON.stringify({ session_id: message.sessionId, files })).toString('base64');\nreturn [{ json: { payload } }];"
      }
    },
    {
      "id": "c1a0b5e2-0001-4000-8000-000000000007",
      "name": "Enregistrer fichiers",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "with payload as (select convert_from(decode($1, 'base64'), 'UTF8')::jsonb as body),\nsaved as (\n  insert into tarik_files (session_id, file_name, mime_type, data)\n  select body->>'session_id', file->>'file_name', file->>'mime_type', decode(file->>'data', 'base64')\n  from payload, jsonb_array_elements(body->'files') as file\n  returning id, file_name\n)\nselect coalesce(json_agg(json_build_object('id', id, 'file_name', file_name) order by id), '[]'::json) as files from saved",
        "options": {
          "queryReplacement": "={{ $json.payload }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "TarikPostgres001",
          "name": "Tarik Postgres"
        }
      }
    },
    {
      "id": "1a10c278-5986-5ed6-a2d4-7573e8d5078f",
      "name": "Questions en attente",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        580,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select coalesce(json_agg(json_build_object('invoice_id', invoice_id, 'question', question) order by created_at), '[]'::json) as pending from tarik_pending where session_id = $1",
        "options": {
          "queryReplacement": "={{ $('Message a Tarik').item.json.sessionId }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "TarikPostgres001",
          "name": "Tarik Postgres"
        }
      }
    },
    {
      "id": "bea448c1-1139-55b3-b34b-6ac4a4252471",
      "name": "Brouillons en attente",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1.1,
      "position": [
        800,
        0
      ],
      "parameters": {
        "endpointUrl": "http://tarik-mcp:8000/mcp",
        "serverTransport": "httpStreamable",
        "tool": {
          "__rl": true,
          "mode": "id",
          "value": "waiting_drafts"
        },
        "inputMode": "json",
        "jsonInput": "={{ JSON.stringify({ session_id: $('Message a Tarik').item.json.sessionId }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "c1a0b5e2-0001-4000-8000-000000000002",
      "name": "Tarik",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        880,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Message a Tarik').item.json.chatInput || '(pas de message)' }}{{ $('Enregistrer fichiers').item.json.files.length ? '\\n\\nFichiers joints : ' + $('Enregistrer fichiers').item.json.files.map(f => f.file_name + ' (fichier n° ' + f.id + ')').join(', ') : '' }}{{ $('Questions en attente').item.json.pending.length ? '\\n\\nQuestions en attente : ' + $('Questions en attente').item.json.pending.map(p => 'facture ' + p.invoice_id + ' : ' + p.question).join(' | ') : '' }}{{ $json.content?.[0]?.text?.invoices?.length ? '\\n\\nFactures en attente de lecture par Experio : ' + $json.content[0].text.invoices.join(', ') : '' }}",
        "options": {
          "systemMessage": "Tu es Tarik, assistant comptable d'un cabinet marocain. Réponds dans la langue du client, en phrases courtes. Vouvoie-le, sans civilité.\n\nCe que tu fais, et seulement cela :\n1. Fichiers reçus : trouve le dossier avec find_dossier, à partir du nom donné par le client. S'il n'a pas dit quel dossier, ou si plusieurs dossiers se ressemblent, demande-lui lequel. Puis appelle traiter_fichiers une seule fois, avec l'id du dossier et les numéros de tous les fichiers joints. Recopie son résultat mot pour mot, facture par facture, sans le reformuler (les numéros surtout).\n2. Questions en attente : elles te sont données avec le message du client. S'il y répond, appelle repondre avec le numéro de la facture et sa réponse, puis recopie le résultat mot pour mot. Sinon, rappelle-lui les questions.\n3. Factures en attente de lecture : elles te sont données avec le message du client. Appelle reprendre une seule fois, puis recopie son résultat mot pour mot.\n4. Le reste : experio_connection pour savoir si Experio fonctionne, list_dossiers pour la liste des dossiers, list_invoices pour les factures d'un dossier (trouve d'abord le dossier avec find_dossier ; filtre possible : en cours, brouillon, comptabilisee, payee). Recopie la liste telle quelle. Pour toute autre demande, dis simplement que tu ne peux pas encore le faire.\n\nRègles :\n- N'invente aucun résultat. Ne propose aucune action que tu ne peux pas faire. Ne dis jamais que tu transmets quelque chose au cabinet.\n- Ne cite ni le nom de tes outils, ni d'autres numéros que ceux des factures.",
          "passthroughBinaryImages": false
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
